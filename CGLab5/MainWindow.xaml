<Window x:Class="CGLab5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Групповая лабораторная: L-системы" Height="700" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <WrapPanel Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Button Content="📂 Загрузить из файла..." Click="LoadFromFile_Click" Margin="5" Padding="10,5"/>
                <Button Content="🌳 Фрактальное дерево (1.б)" Click="FractalTree_Click" Margin="5" Padding="10,5" 
                        FontWeight="Bold" Foreground="DarkGreen" Background="#E8F5E9"/>

                <Separator Width="1" Margin="15,5" Background="Gray"/>

                <TextBlock Text="Итерации:" VerticalAlignment="Center" Margin="5,0"/>
                <TextBox x:Name="IterationsTextBox" Text="5" Width="50" Margin="5" VerticalContentAlignment="Center" TextAlignment="Center"/>

                <CheckBox x:Name="RandomnessCheckBox" Content="Случайность углов" Margin="15,0" VerticalAlignment="Center"/>

                <Separator Width="1" Margin="15,5" Background="Gray"/>

                <Button Content="🔄 Перерисовать" Click="Redraw_Click" Margin="5" Padding="10,5"/>
                <Button Content="❌ Очистить" Click="Clear_Click" Margin="5" Padding="10,5"/>
            </WrapPanel>
        </Border>

        <!-- Canvas без RenderTransform -->
        <Canvas x:Name="FractalCanvas" Grid.Row="1" Background="White" ClipToBounds="True"/>
    </Grid>
</Window>